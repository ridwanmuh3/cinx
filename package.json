{
  "name": "ticketing-cinema",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test",
    "demo": "./scripts/demo-walkthrough.sh",
    "health": "curl -s http://localhost:3000/api/v1/health",
    "bench:smoke": "k6 run benchmark/smoke.js",
    "bench:load": "k6 run benchmark/load.js",
    "bench:stress": "k6 run benchmark/stress.js",
    "bench:soak": "k6 run benchmark/soak.js",
    "bench:contention": "k6 run benchmark/seat-contention.js",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "infra:psql": "docker compose -f infra/docker-compose.yml exec postgres psql -U postgres -d ${DB:-user_db}",
    "docker:up": "docker compose up -d --build",
    "docker:up:prod": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:images": "docker compose images",
    "docker:config": "docker compose config",
    "docker:psql": "docker compose exec postgres psql -U postgres -d ${DB:-user_db}",
    "docker:seed": "docker compose --profile seed run --rm seed",
    "ci:local": "act -W .github/workflows/ci.yaml",
    "cd:local": "act -W .github/workflows/cd.yaml"
  },
  "pnpm": {
    "overrides": {
      "multer": ">=2.3.0 <3",
      "qs": ">=6.16.0",
      "js-yaml": ">=4.3.2"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@nestjs/testing": "^11.1.29",
    "@types/jest": "^29.5.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.1",
    "jest": "^29.7.0",
    "jest-mock-extended": "^4.0.0",
    "prettier": "^3.6.0",
    "ts-jest": "^29.4.0",
    "turbo": "^2.10.9",
    "typescript-eslint": "^8.0.0"
  }
}
