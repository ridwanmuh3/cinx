{
  "name": "@ticketing/ticket-service",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "smoke:redis": "tsx src/scripts/redis-smoke.ts",
    "reconcile": "tsx src/scripts/reconcile.ts",
    "xendit:webhook": "tsx src/scripts/setup-xendit-webhook.ts",
    "seed": "tsx src/scripts/seed.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write --ignore-path ../../.prettierignore .",
    "format:check": "prettier --check --ignore-path ../../.prettierignore .",
    "test": "jest --testPathIgnorePatterns=integration-spec",
    "test:cov": "jest --coverage --testPathIgnorePatterns=integration-spec",
    "test:integration": "jest --config ./jest.integration.config.js --runInBand --forceExit"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "integration-spec"
    ],
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.29",
    "@nestjs/core": "^11.1.29",
    "@nestjs/microservices": "^11.1.29",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/typeorm": "^11.0.3",
    "@ticketing/shared": "workspace:*",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "redlock": "^5.0.0-beta.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@ticketing/eslint-config": "workspace:*",
    "@types/jest": "^29.5.0",
    "@types/node": "^24.0.0",
    "jest": "^29.7.0",
    "jest-mock-extended": "^4.0.0",
    "ts-jest": "^29.4.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
