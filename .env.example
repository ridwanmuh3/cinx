# Copy to .env and adjust for your environment.
# docker compose reads these automatically.

# Security (change in production!)
# JWT_SECRET must be >= 32 chars; services refuse to boot without it.
# Generate: openssl rand -base64 32
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
PG_PASSWORD=change-me-too
# Comma-separated extra origins allowed by the gateway CORS policy.
# Leave empty for same-origin only (SPA served from the gateway origin).
# CORS_ORIGINS=https://cinema.example.com
# Password for the seeded admin account (seed-admin script). Min 12 chars.
# SEED_ADMIN_PASSWORD=

# Published host ports
WEB_PORT=4200
GATEWAY_PORT=3000

# Image tag used by CI/CD (ghcr.io pushes). Leave empty to default to latest.
IMAGE_TAG=latest

# RabbitMQ (Infrastructure)
RMQ_URL=amqp://rabbitmq:5672
RMQ_EXCHANGE=ticketing.events
RMQ_EXCHANGE_TYPE=fanout
RMQ_NOTIFICATION_QUEUE=notification.queue
RMQ_INTERNAL_EXCHANGE=ticketing.internal

# Xendit (live payments — no mock provider)
# Get the secret key + webhook token from https://dashboard.xendit.co/settings/developers
# The gateway webhook endpoint is /api/v1/payments/xendit/webhook.
XENDIT_API_URL=https://api.xendit.co
XENDIT_SECRET_KEY=xnd_development_xxxxx
XENDIT_WEBHOOK_TOKEN=change-me-to-xendit-webhook-token
# Public HTTPS URL of the webhook endpoint — used only by the setup script
# (pnpm --filter @ticketing/ticket-service xendit:webhook) to register the
# callback with Xendit. Local dev: run `cloudflared tunnel --url http://localhost:3000`
# and paste the printed https URL here.
# XENDIT_WEBHOOK_URL=https://your-domain.example.com/api/v1/payments/xendit/webhook
# Optional override for success/failure redirects (defaults to EMAIL_BASE_URL)
# XENDIT_RETURN_URL=http://localhost:4200

# Email (production only)
RESEND_API_KEY=replay_xxxxx
RESEND_FROM=CinX <no-reply@example.com>
EMAIL_BASE_URL=http://localhost:4200

# Redis
REDIS_URL=redis://redis:6379

# PostgreSQL cluster DB names (optional, defaults to user_db, cinema_db, ticket_db)
PG_USER_DB=user_db
PG_CINEMA_DB=cinema_db
PG_TICKET_DB=ticket_db

# Gateway service hostnames (for docker-compose)
USER_HOST=user-service
CINEMA_HOST=cinema-service
TICKET_HOST=ticket-service

# Observability (OpenTelemetry -> Tempo + Prometheus -> Grafana)
# Services export OTLP traces+metrics to the collector; see README
# "Observability". All of these have working defaults for docker compose.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_METRIC_EXPORT_INTERVAL=60000
DEPLOY_ENV=development
# Set to 'true' to run a service with telemetry fully disabled
# (unit tests and CI always run disabled).
# OTEL_SDK_DISABLED=true

# Grafana UI (http://localhost:3001). Change the password for real deploys!
GRAFANA_PORT=3001
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=change-me-too

# Browser tracing (Vue SPA). Relative URL keeps the same-origin relay
# through the gateway (POST /api/v1/otel/v1/traces -> collector).
VITE_OTEL_ENDPOINT=/api/v1/otel
VITE_OTEL_SAMPLE_RATIO=0.2